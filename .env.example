# E-Commerce Multi-Vendor Platform Environment Variables
# Copy this file to .env and update the values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_USERNAME=ecommerce_user
DB_PASSWORD=your_secure_password_here

# ===========================================
# PAYMENT GATEWAY CONFIGURATION
# ===========================================
# Razorpay Configuration
RAZORPAY_KEY=your_razorpay_key_here
RAZORPAY_SECRET=your_razorpay_secret_here

# Stripe Configuration
STRIPE_KEY=your_stripe_secret_key_here

# Frontend Payment Keys (Public keys - safe to expose)
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_publishable_key_here
REACT_APP_RAZORPAY_KEY=your_razorpay_key_here

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# ===========================================
# AI CONFIGURATION
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your_very_secure_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRATION=86400000

# ===========================================
# FEATURE FLAGS
# ===========================================
REACT_APP_ENABLE_AI_CHATBOT=true
REACT_APP_ENABLE_WISHLIST=true
REACT_APP_ENABLE_REVIEWS=true

# ===========================================
# REDIS CONFIGURATION (Optional)
# ===========================================
REDIS_PASSWORD=your_redis_password

# ===========================================
# MONITORING CONFIGURATION (Optional)
# ===========================================
GRAFANA_PASSWORD=your_grafana_admin_password

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# Uncomment and set these for production deployment
# DOMAIN=your-domain.com
# SSL_EMAIL=admin@your-domain.com
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===========================================
# SOCIAL MEDIA LINKS
# ===========================================
REACT_APP_FACEBOOK_URL=https://facebook.com/yourpage
REACT_APP_TWITTER_URL=https://twitter.com/yourhandle
REACT_APP_INSTAGRAM_URL=https://instagram.com/yourhandle